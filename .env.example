# =====================================================================
# CFO Alunos — variáveis de ambiente
# Copie este arquivo para `.env.local` e preencha com seus valores.
# =====================================================================

# ---- Supabase ----
# Public (browser): URL e anon key do projeto Supabase.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxx

# Server-only: chave service_role (NUNCA exposta ao browser).
# Usada por server actions/route handlers que precisem bypassar RLS
# (ex.: criação de usuário inicial pela Coordenação).
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxx

# ---- Alertas externos de aniversario ----
# Gere o par uma unica vez com: pnpm exec web-push generate-vapid-keys
# A chave publica pode ir ao browser; a privada deve permanecer secreta.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=BPxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VAPID_PRIVATE_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VAPID_SUBJECT=mailto:coordenacao@seu-dominio.gov.br

# E-mail complementar via Resend (dominio remetente deve estar verificado).
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxx
BIRTHDAY_EMAIL_FROM=CFO Alunos <aniversarios@seu-dominio.gov.br>

# Vercel Cron envia automaticamente este valor em Authorization: Bearer.
# Use um segredo aleatorio com pelo menos 16 caracteres.
CRON_SECRET=troque-por-um-segredo-longo-e-aleatorio

# ---- Aplicação ----
NEXT_PUBLIC_APP_NAME=CFO Alunos
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Ambiente: development | production
NODE_ENV=development

# ---- Scripts operacionais ----
# Senha inicial usada por scripts/reset-students-passwords.ts ao redefinir a
# senha de TODOS os alunos. NUNCA hardcoded no código. Política exigida pelo
# fluxo de primeiro acesso: mín. 8 caracteres, 1 maiúscula, 1 dígito.
# No primeiro login o aluno é redirecionado para /primeiro-acesso e troca.
STUDENT_DEFAULT_PASSWORD=ExemploSenh@1
