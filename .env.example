# =====================================================================
# CFO Alunos — variáveis de ambiente
# Copie este arquivo para `.env.local` e preencha com seus valores.
# =====================================================================

# ---- Supabase ----
# Public (browser): URL e anon key do projeto Supabase.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxx

# Server-only: chave service_role (NUNCA exposta ao browser).
# Usada por server actions/route handlers que precisem bypassar RLS
# (ex.: criação de usuário inicial pela Coordenação).
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxx

# ---- Aplicação ----
NEXT_PUBLIC_APP_NAME=CFO Alunos
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Ambiente: development | production
NODE_ENV=development
